<?xml version="1.0" encoding="utf-8"?>
<!-- Компоненты встроенного Chromium-рантайма (Cefrium/CEF) для flavor chromium.

     Рантайм подкладывается в APK на этапе CI (tools/inject_cefrium_runtime.py), а не как
     Gradle-зависимость: AAR SDK везёт полный ресурсный набор Chrome и конфликтует
     с androidx по attr/string/layout, из-за чего resource merger падает.
     Поэтому объявления компонентов живут здесь, в манифесте конкретного flavor. -->
